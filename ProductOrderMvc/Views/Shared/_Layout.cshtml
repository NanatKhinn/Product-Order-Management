<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProductOrderMvc</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ProductOrderMvc</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1" id="nav-menu">
                       
                        <li class="nav-item" id="home-tab-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home / Login</a>
                        </li>

                      
                        <li class="nav-item" id="admin-product-tab" style="display: none;">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="ProductManagement">Product Management</a>
                        </li>
                        <li class="nav-item" id="order-management-tab" style="display: none;">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="OrderManagement">Order Management</a>
                        </li>

                    
                        <li class="nav-item" id="order-tab" style="display: none;">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Order">Orders</a>
                        </li>
                    </ul>

                   
                    <ul class="navbar-nav">
                        <li class="nav-item" id="logout-item" style="display: none;">
                            <button class="btn btn-outline-danger btn-sm mt-1" onclick="handleLogout()">Logout</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container">
            © 2026 - ProductOrderMvc
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

   
    <script>
            function parseJwt(token) {
                try {
                    var base64Url = token.split('.')[1];
                    var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                    var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function (c) {
                        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                    }).join(''));
                    return JSON.parse(jsonPayload);
                } catch (e) {
                    return null;
                }
            }

            document.addEventListener("DOMContentLoaded", function () {
                const token = localStorage.getItem('token');
                const homeTabItem = document.getElementById('home-tab-item');
                const logoutItem = document.getElementById('logout-item');
                const adminProductTab = document.getElementById('admin-product-tab');
                const orderTab = document.getElementById('order-tab');
                const orderManagementTab = document.getElementById('order-management-tab');

                if (token) {
                    if (homeTabItem) homeTabItem.style.display = 'none';
                    if (logoutItem) logoutItem.style.display = 'block';
                    //if (orderTab) orderTab.style.display = 'block'; // 

                    const decodedToken = parseJwt(token);
                    const userRole = decodedToken ? (
                        decodedToken["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] ||
                        decodedToken["role"] ||
                        decodedToken["Role"] ||
                        decodedToken["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/role"]
                    ) : null;

                    if (userRole && userRole.toLowerCase() === 'admin') {
                        if (adminProductTab) adminProductTab.style.display = 'block'; 
                        if (orderManagementTab) orderManagementTab.style.display = 'block'
                    }
                } else {
                    if (logoutItem) logoutItem.style.display = 'none';
                }
            });

            function handleLogout() {
                localStorage.removeItem('token');
                window.location.href = '/Home/Index';
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>