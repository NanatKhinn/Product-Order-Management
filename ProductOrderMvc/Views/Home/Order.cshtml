@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Customer - Order Products";
    var apiUrl = Configuration["ApiSettings:BaseUrl"];
}

<div id="root" class="container mt-4"></div>


<script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
<script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script type="text/babel">
    const API_BASE_URL = '@apiUrl';

    function CustomerOrderApp() {
        const [products, setProducts] = React.useState([]);
        const [cart, setCart] = React.useState([]);
        const [myOrders, setMyOrders] = React.useState([]);
        const [loading, setLoading] = React.useState(true);
        const [message, setMessage] = React.useState({ text: '', type: '' });

       
        const [quantities, setQuantities] = React.useState({});

        const token = localStorage.getItem('token');
        const headers = { Authorization: `Bearer ${token}` };

        // 1. all Product retrieve
        const fetchProducts = async () => {
            try {
                const response = await axios.get(`${API_BASE_URL}/product/get-all-products`, { headers });
                const data = response.data.data || response.data;
                setProducts(data);

               
                const initialQtys = {};
                data.forEach(p => {
                    initialQtys[p.id] = 1;
                });
                setQuantities(initialQtys);

                setLoading(false);
            } catch (err) {
                console.error("Error fetching products:", err);
                setMessage({ text: 'Failed to load products.', type: 'danger' });
                setLoading(false);
            }
        };

       
        // 2. User Order 
        const fetchMyOrders = async () => {
            try {
                const response = await axios.get(`${API_BASE_URL}/order/get-user-orders`, { headers });

                
                const resultData = response.data;
                if (Array.isArray(resultData)) {
                    setMyOrders(resultData);
                } else if (resultData.data && Array.isArray(resultData.data)) {
                    setMyOrders(resultData.data);
                } else if (resultData.Data && Array.isArray(resultData.Data)) {
                    setMyOrders(resultData.Data);
                } else {
                    setMyOrders([]); 
                }
            } catch (err) {
                console.error("Error fetching orders:", err);
                setMyOrders([]);
            }
        };

        React.useEffect(() => {
            fetchProducts();
            fetchMyOrders();
        }, []);

       
        const handleQtyChange = (productId, value) => {
            setQuantities({
                ...quantities,
                [productId]: parseInt(value) || 1
            });
        };

        // add to Cart 
        const addToCart = (product) => {
            const qty = quantities[product.id] || 1;
            if (qty <= 0) return;

            if (qty > product.stock) {
                alert(`Insufficient stock! Available: ${product.stock}`);
                return;
            }

            const existingItem = cart.find(item => item.productId === product.id);
            if (existingItem) {
                setCart(cart.map(item =>
                    item.productId === product.id
                        ? { ...item, quantity: item.quantity + qty }
                        : item
                ));
            } else {
                setCart([...cart, { productId: product.id, name: product.name, price: product.price, quantity: qty, stock: product.stock }]);
            }
        };

        
        const removeFromCart = (productId) => {
            setCart(cart.filter(item => item.productId !== productId));
        };

        // Order Submit 
        const handleCheckout = async () => {
            if (cart.length === 0) {
                setMessage({ text: 'Your cart is empty.', type: 'warning' });
                return;
            }

            try {
                const orderPayload = {
                    orderItems: cart.map(item => ({
                        productId: item.productId,
                        quantity: item.quantity
                    }))
                };

                await axios.post(`${API_BASE_URL}/order/create-order`, orderPayload, { headers });
                setMessage({ text: 'Order placed successfully!', type: 'success' });
                setCart([]);
                fetchProducts();
                fetchMyOrders();
            } catch (err) {
                console.error("Checkout error:", err.response?.data);
                setMessage({ text: err.response?.data?.message || 'Failed to place order.', type: 'danger' });
            }
        };

        return (
            <div className="container">
                <h2 className="mb-4 text-primary font-weight-bold">Customer Order Portal</h2>

                {message.text && (
                    <div className={`alert alert-${message.type}`} role="alert">
                        {message.text}
                    </div>
                )}

                <div className="row">
                    {/* --- Product List Section --- */}
                    <div className="col-md-7">
                        <div className="card shadow-sm p-4 mb-4">
                            <h4 className="mb-3">Available Products</h4>
                            {loading ? (
                                <p>Loading products...</p>
                            ) : (
                                <div className="table-responsive">
                                    <table className="table table-striped align-middle">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Price</th>
                                                <th>Stock</th>
                                                <th>Qty</th>
                                                <th className="text-end">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {products.map(p => (
                                                <tr key={p.id}>
                                                    <td className="fw-bold">{p.name}</td>
                                                    <td>${p.price}</td>
                                                    <td><span className="badge bg-secondary">{p.stock}</span></td>
                                                    <td>
                                                        <input
                                                            type="number"
                                                            min="1"
                                                            max={p.stock}
                                                            value={quantities[p.id] || 1}
                                                            onChange={(e) => handleQtyChange(p.id, e.target.value)}
                                                            className="form-control form-control-sm"
                                                            style={{ width: '60px' }}
                                                        />
                                                    </td>
                                                    <td className="text-end">
                                                        <button
                                                            className="btn btn-sm btn-outline-success"
                                                            onClick={() => addToCart(p)}
                                                            disabled={p.stock <= 0}
                                                        >
                                                            {p.stock > 0 ? 'Add to Cart' : 'Out of Stock'}
                                                        </button>
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            )}
                        </div>
                    </div>

                    {/* --- Shopping Cart Section --- */}
                    <div className="col-md-5">
                        <div className="card shadow-sm p-4 mb-4">
                            <h4 className="mb-3">Shopping Cart</h4>
                            {cart.length === 0 ? (
                                <p className="text-muted">Cart is empty.</p>
                            ) : (
                                <div>
                                    <ul className="list-group mb-3">
                                        {cart.map((item, index) => (
                                            <li key={index} className="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 className="my-0">{item.name}</h6>
                                                    <small className="text-muted">${item.price} x {item.quantity}</small>
                                                </div>
                                                <span className="text-muted">${(item.price * item.quantity).toFixed(2)}</span>
                                                <button className="btn btn-sm btn-danger" onClick={() => removeFromCart(item.productId)}>X</button>
                                            </li>
                                        ))}
                                    </ul>
                                    <button className="btn btn-primary w-100" onClick={handleCheckout}>Place Order</button>
                                </div>
                            )}
                        </div>
                    </div>
                </div>

                {/* --- My Order History --- */}
                <div className="card shadow-sm p-4">
                    <h4 className="mb-3">My Order History</h4>
                    {myOrders.length === 0 ? (
                        <p className="text-muted">No orders found.</p>
                    ) : (
                        <div className="table-responsive">
                            <table className="table table-bordered">
                               <thead>
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Date</th>
                                        <th>Total Amount</th>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    {myOrders.map(order => (
                                        <tr key={order.Id || order.id}>
                                            <td>#{order.Id || order.id}</td>
                                            <td>{new Date(order.OrderDate || order.orderDate).toLocaleString()}</td>
                                            <td>${order.TotalAmount || order.totalAmount}</td>
                                           
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    )}
                </div>
            </div>
        );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<CustomerOrderApp />);
</script>