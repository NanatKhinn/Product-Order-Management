@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Admin - Product Management";
    var apiUrl = Configuration["ApiSettings:BaseUrl"];
}

<div id="root" class="container mt-4"></div>


<script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
<script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script type="text/babel">
    const API_BASE_URL = '@apiUrl';

    function AdminProductApp() {
        const [products, setProducts] = React.useState([]);
        const [loading, setLoading] = React.useState(true);
        const [message, setMessage] = React.useState({ text: '', type: '' });

        
        const [formData, setFormData] = React.useState({ id: null, name: '', description: '', price: '', stock: '' });
        const [isEditing, setIsEditing] = React.useState(false);

       
        const token = localStorage.getItem('token');

        
        const fetchProducts = async () => {
            try {
                const response = await axios.get(`${API_BASE_URL}/product/get-all-products`);
                const data = response.data.data || response.data;
                setProducts(data);
                setLoading(false);
            } catch (err) {
                console.error("Error fetching products:", err);
                setMessage({ text: 'Failed to load products.', type: 'danger' });
                setLoading(false);
            }
        };

        React.useEffect(() => {
            fetchProducts();
        }, []);

        const handleChange = (e) => {
            setFormData({ ...formData, [e.target.name]: e.target.value });
        };

        
        const handleSubmit = async (e) => {
            e.preventDefault();
            try {
                const headers = { Authorization: `Bearer ${token}` };

                if (isEditing) {
                    // Update Product 
                    await axios.patch(`${API_BASE_URL}/product/update-product/${formData.id}`, formData, { headers });
                    setMessage({ text: 'Product updated successfully!', type: 'success' });
                } else {
                    // Create Product 
                    const { id, ...dataToSend } = formData;
                    await axios.post(`${API_BASE_URL}/product/create-product`, dataToSend, { headers });
                    setMessage({ text: 'Product created successfully!', type: 'success' });
                }

                setFormData({ id: null, name: '', description: '', price: '', stock: '' });
                setIsEditing(false);
                fetchProducts();
            } catch (err) {
                console.error("Save error:", err.response?.data);
                setMessage({ text: err.response?.data?.message || 'Operation failed. Admin access required.', type: 'danger' });
            }
        };

        // Edit
        const handleEdit = (product) => {
            setFormData(product);
            setIsEditing(true);
        };

        return (
            <div className="container">
                <h2 className="mb-4 text-primary font-weight-bold">Admin - Product Management</h2>

                {message.text && (
                    <div className={`alert alert-${message.type}`} role="alert">
                        {message.text}
                    </div>
                )}

                {/* --- Product Form (Create / Edit) --- */}
                <div className="card shadow-sm p-4 mb-4">
                    <h4 className="mb-3">{isEditing ? 'Edit Product' : 'Add New Product'}</h4>
                    <form onSubmit={handleSubmit}>
                        <div className="row">
                            <div className="col-md-3 mb-3">
                                <label className="form-label">Product Name</label>
                                <input type="text" name="name" className="form-control" value={formData.name || ''} onChange={handleChange} required />
                            </div>
                            <div className="col-md-4 mb-3">
                                <label className="form-label">Description</label>
                                <input type="text" name="description" className="form-control" value={formData.description || ''} onChange={handleChange} required />
                            </div>
                            <div className="col-md-2 mb-3">
                                <label className="form-label">Price ($)</label>
                                <input type="number" step="0.01" name="price" className="form-control" value={formData.price || ''} onChange={handleChange} required />
                            </div>
                            <div className="col-md-2 mb-3">
                                <label className="form-label">Stock</label>
                                <input type="number" name="stock" className="form-control" value={formData.stock || ''} onChange={handleChange} required />
                            </div>
                            <div className="col-md-1 d-flex align-items-end mb-3">
                                <button type="submit" className={`btn btn-${isEditing ? 'warning' : 'success'} w-100`}>
                                    {isEditing ? 'Update' : 'Add'}
                                </button>
                            </div>
                        </div>
                        {isEditing && (
                            <button type="button" className="btn btn-secondary btn-sm mt-2" onClick={() => { setIsEditing(false); setFormData({ id: null, name: '', description: '', price: '', stock: '' }); }}>
                                Cancel Edit
                            </button>
                        )}
                    </form>
                </div>

                {/* --- Product List Table */}
                <div className="card shadow-sm p-4">
                    <h4 className="mb-3">Product List</h4>
                    {loading ? (
                        <p>Loading products...</p>
                    ) : (
                        <div className="table-responsive">
                            <table className="table table-striped align-middle">
                               <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th className="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {products.map(p => (
                                        <tr key={p.id}>
                                            <td className="fw-bold">{p.name}</td>
                                            <td>{p.description}</td>
                                            <td>${p.price}</td>
                                            <td><span className="badge bg-secondary">{p.stock}</span></td>
                                            <td className="text-end">
                                                <button className="btn btn-sm btn-outline-primary" onClick={() => handleEdit(p)}>Edit</button>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    )}
                </div>
            </div>
        );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<AdminProductApp />);
</script>